# Render API base URL, including the /api/v1 prefix (task 1.6 / SD §7)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Absolute URL of the deployed site (e.g. https://www.example.com), used as metadataBase for
# Open Graph/Twitter image URLs. Optional: unset leaves Next's default.
NEXT_PUBLIC_SITE_URL=

# Sentry DSN for the coin-collector-web project. Optional: unset disables error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# PostHog project token (phc_...). Optional: unset disables analytics.
NEXT_PUBLIC_POSTHOG_TOKEN=
# PostHog Cloud region for the /relay proxy: us (default) or eu.
NEXT_PUBLIC_POSTHOG_REGION=us
