// v2 data model — see docs/system-design_v2.md §4.1 for the full rationale behind each
// constraint below (natural-key uniqueness on Coin, why mintMark/variety default to ''
// instead of null, why the clone FKs are onDelete: SetNull, why Ownership has no FK to
// UserSet/UserSetCoin at all).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// In-app admin role. Read from the database on every admin request by RolesGuard (never
// trusted from the JWT), so a demotion applies immediately. Granted only via
// apps/api/scripts/set-user-role.ts.
enum Role {
  user
  admin
}

enum CoinStatus {
  approved
  pending
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())

  userSets       UserSet[]
  ownerships     Ownership[]
  submittedCoins Coin[]      @relation("CoinSubmitter")
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  feedbacks      Feedback[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  familyId  String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Coin {
  id                String     @id @default(uuid())
  country           String
  denomination      String
  year              Int
  mintMark          String     @default("") // never null — see §4.1 NULL-distinctness note
  variety           String     @default("")
  name              String
  status            CoinStatus @default(approved)
  submittedByUserId String?
  submittedAt       DateTime?
  // Optional admin note on a rejection. Only ever returned to the submitter
  // (GET /catalog?submittedByMe=true) and to admins, never on public catalog reads.
  rejectionReason   String?
  imageUrl          String?
  imageSource       String?
  imageLicense      String?
  // Physical specs + mintage. Float (Postgres double precision), not Decimal/BigInt:
  // sets/collection return coins via `include: { coin: true }`, where Decimal would
  // serialize as a string and BigInt would throw in JSON.stringify. Doubles hold
  // integers exactly up to 2^53, far beyond any real mintage. All nullable: an
  // unknown value is shown as absent, never guessed.
  diameterMm        Float?
  weightG           Float?
  thicknessMm       Float?
  material          String?
  mintage           Float?
  isKeyDate         Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  canonicalSetCoins CanonicalSetCoin[]
  userSetCoins      UserSetCoin[]
  ownerships        Ownership[]
  submitter         User?              @relation("CoinSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@unique([country, denomination, year, mintMark, variety])
}

model CanonicalSet {
  id              String  @id @default(uuid())
  name            String
  description     String?
  source          String // "admin" | "seed-template"
  templateVersion String

  coins    CanonicalSetCoin[]
  userSets UserSet[]          @relation("ClonedFromCanonical")
}

model CanonicalSetCoin {
  id             String @id @default(uuid())
  canonicalSetId String
  coinId         String
  position       Int

  canonicalSet CanonicalSet @relation(fields: [canonicalSetId], references: [id], onDelete: Cascade)
  coin         Coin         @relation(fields: [coinId], references: [id])

  @@unique([canonicalSetId, coinId])
}

model UserSet {
  id                    String   @id @default(uuid())
  userId                String
  name                  String
  clonedFromCanonicalId String?
  clonedFromUserSetId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User          @relation(fields: [userId], references: [id])
  clonedFromCanonical CanonicalSet? @relation("ClonedFromCanonical", fields: [clonedFromCanonicalId], references: [id], onDelete: SetNull)
  clonedFromUserSet   UserSet?      @relation("ClonedFromUserSet", fields: [clonedFromUserSetId], references: [id], onDelete: SetNull)
  clones              UserSet[]     @relation("ClonedFromUserSet")

  coins UserSetCoin[]
}

model UserSetCoin {
  id        String @id @default(uuid())
  userSetId String
  coinId    String
  position  Int

  userSet UserSet @relation(fields: [userSetId], references: [id], onDelete: Cascade)
  coin    Coin    @relation(fields: [coinId], references: [id])

  @@unique([userSetId, coinId])
}

model Ownership {
  userId  String
  coinId  String
  ownedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  coin Coin @relation(fields: [coinId], references: [id])

  @@id([userId, coinId])
}

// backlog_password-management.md Step 3 (decision 8) — single-use, short-lived password
// reset tokens. Only a sha256 hash of the raw token is stored, same as RefreshToken.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
