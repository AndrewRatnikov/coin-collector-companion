# Postgres connection string (Neon pooled connection in prod — see task 1.4)
DATABASE_URL=

# HS256 signing secret for auth JWTs (task 2.2) — generate, never commit
JWT_SECRET=

# Vercel production origin allowed by CORS in addition to http://localhost:3000
CORS_ORIGIN=

# Provided by Render in deployment; defaults to 3000 locally
PORT=3000

# Web app origin that password reset links point to (<FRONTEND_URL>/reset-password?token=...).
# Optional: falls back to CORS_ORIGIN, then http://localhost:3000
FRONTEND_URL=

# Resend API key for password reset emails. If unset, no email is sent (the request still
# returns the normal response). Without a verified domain, Resend only delivers to the
# address you signed up to Resend with.
RESEND_API_KEY=

# Optional sender. Defaults to "Coin Collector Companion <onboarding@resend.dev>", which
# works without a verified domain.
EMAIL_FROM=

# Local dev only: set to true to log reset links when RESEND_API_KEY is unset. Never in production.
EMAIL_LOG_RESET_LINKS=
